    {
      "scene": 17,
      "tone": "warm",
      "wav": "assets/channels/channel1/voice/sword/man/17.wav",
      "start": 859.45,
      "dur": 43.35,
      "speech_start": 0.34,
      "speech_end": 41.78,
      "sentences": [
        {
          "i": 0,
          "text": "And think, for a moment, about how much a lie has to carry just to stay on its feet.",
          "start": 0.34,
          "dur": 6.902,
          "abs_start": 859.79
        },
        {
          "i": 1,
          "text": "It has to bend the facts, bury half of them, and count on you never once going back to check.",
          "start": 7.242,
          "dur": 6.768,
          "abs_start": 866.692
        },
        {
          "i": 2,
          "text": "The truth carries none of that weight.",
          "start": 14.01,
          "dur": 2.683,
          "abs_start": 873.46
        },
        {
          "i": 3,
          "text": "It simply walks in a straight line.",
          "start": 16.693,
          "dur": 2.548,
          "abs_start": 876.143
        },
        {
          "i": 4,
          "text": "And we are going to keep walking it, story after story, through everything they told you was settled and beyond question.",
          "start": 19.241,
          "dur": 9.193,
          "abs_start": 878.691
        },
        {
          "i": 5,
          "text": "So if you are tired of being made to feel small about who you are, do not just watch this and leave.",
          "start": 28.434,
          "dur": 7.303,
          "abs_start": 887.884
        },
        {
          "i": 6,
          "text": "Subscribe, and stand with us, because there is a great deal more of this still to come.",
          "start": 35.737,
          "dur": 6.043,
          "abs_start": 895.187
        }
      ],
