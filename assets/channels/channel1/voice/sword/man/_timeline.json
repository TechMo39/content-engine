        }
      ]
    },
    {
      "scene": 5,
      "tone": "nadruk",
      "wav": "assets/channels/channel1/voice/sword/man/05.wav",
      "start": 228.275,
      "dur": 46.5,
      "speech_start": 0.34,
      "speech_end": 45.16,
      "tech": "kaart",
      "view": "mena",
      "fills": {
        "byz": "red",
        "persia": "blue"
      },
      "labels": {
        "byz": "Roman Empire",
        "persia": "Persian Empire"
      },
      "kaartInfo": "The 630s: both empires fall",
      "sentences": [
        {
          "i": 0,
          "text": "Now watch what replaced it.",
          "start": 0.34,
          "dur": 2,
          "abs_start": 228.615
        },
        {
          "i": 1,
          "text": "In the 630s, within a single generation, the Muslims did something the world thought impossible.",
          "start": 2.34,
          "dur": 8.085,
          "abs_start": 230.615
        },
        {
          "i": 2,
          "text": "They did not face down one superpower.",
          "start": 10.425,
          "dur": 3.485,
          "abs_start": 238.7
        },
        {
          "i": 3,
          "text": "They faced two.",
          "start": 13.91,
          "dur": 1.54,
          "abs_start": 242.185
        },
        {
          "i": 4,
          "text": "They took the Christian Roman east, and alongside it they brought down the entire Persian empire, the other great power of the age, with its own state religion enforced from the top.",
          "start": 15.45,
          "dur": 13.811,
          "abs_start": 243.725
        },
        {
          "i": 5,
          "text": "Two empires that had divided the known world between them, now in the hands of the believers.",
          "start": 29.261,
          "dur": 7.564,
          "abs_start": 257.536
        },
        {
          "i": 6,
          "text": "And it is right here, at the very height of that power, that the whole accusation quietly falls apart.",
          "start": 36.825,
          "dur": 8.335,
          "abs_start": 265.1
        }
      ],
      "beats": [
        {
          "start": 0.34,
          "dur": 15.11,
          "label": "kaart: twee rijken",
          "img": "",
          "vid": ""
        },
        {
          "start": 15.45,
          "dur": 21.375,
