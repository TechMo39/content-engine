    {
      "scene": 8,
      "tone": "rustig",
      "wav": "assets/channels/channel1/voice/chose/v2/08.wav",
      "start": 344.47,
      "dur": 69.12,
      "speech_start": 0.0,
      "speech_end": 68.57,
      "sentences": [
        {
          "i": 0,
          "text": "So I started paying attention.",
          "start": 0.0,
          "dur": 2.448,
          "abs_start": 344.47
        },
        {
          "i": 1,
          "text": "If people did not reason their way to this answer, then how did it get in?",
          "start": 2.448,
          "dur": 5.364,
          "abs_start": 346.918
        },
        {
          "i": 2,
          "text": "And as far as I can tell, it comes in through five quiet doors.",
          "start": 7.812,
          "dur": 4.538,
          "abs_start": 352.282
        },
        {
          "i": 3,
          "text": "The first is home.",
          "start": 12.85,
          "dur": 1.472,
          "abs_start": 357.32
        },
        {
          "i": 4,
          "text": "Your parents believed something, or they believed in nothing, and it was already yours before you could even speak.",
          "start": 14.322,
          "dur": 9.944,
          "abs_start": 358.792
        },
        {
          "i": 5,
          "text": "The second is a single moment.",
          "start": 24.266,
          "dur": 2.674,
          "abs_start": 368.736
        },
        {
          "i": 6,
          "text": "Something happened that you could not explain, you took it as proof, and you never went back to look at it again.",
          "start": 27.44,
          "dur": 7.978,
          "abs_start": 371.91
        },
        {
          "i": 7,
          "text": "The third is the people around you.",
          "start": 35.418,
          "dur": 2.283,
          "abs_start": 379.888
        },
        {
          "i": 8,
          "text": "Everyone near you leaned one way, and leaning with them was easier than standing alone.",
          "start": 37.701,
          "dur": 6.029,
          "abs_start": 382.171
        },
        {
          "i": 9,
          "text": "The fourth is the world itself.",
          "start": 44.23,
          "dur": 2.186,
          "abs_start": 388.7
        },
        {
          "i": 10,
          "text": "The films, the songs, the things you were taught as if they were just obviously true.",
          "start": 46.416,
          "dur": 5.561,
          "abs_start": 390.886
        },
        {
          "i": 11,
          "text": "A thousand small nudges you never once felt as nudges.",
          "start": 51.977,
          "dur": 4.123,
          "abs_start": 396.447
        },
        {
          "i": 12,
          "text": "And the fifth is pain.",
          "start": 56.6,
          "dur": 1.539,
          "abs_start": 401.07
        },
        {
          "i": 13,
          "text": "Someone hurt you in the name of their answer, so you took the opposite one.",
          "start": 58.139,
          "dur": 5.346,
          "abs_start": 402.609
        },
        {
          "i": 14,
          "text": "Not because you weighed it, but because you were walking away from them.",
          "start": 63.485,
          "dur": 5.085,
          "abs_start": 407.955
        }
      ],
      "beats": [
        {
          "start": 0.0,
          "dur": 12.85,
          "label": "de vijf deuren",
          "img": "",
          "vid": "assets/channels/channel1/video/chose/s08b1__c1.mp4"
        },
        {
          "start": 12.85,
          "dur": 14.59,
          "label": "thuis",
          "img": "",
