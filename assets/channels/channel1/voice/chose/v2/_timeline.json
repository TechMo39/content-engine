    {
      "scene": 13,
      "tone": "outro",
      "wav": "assets/channels/channel1/voice/chose/v2/13.wav",
      "start": 632.2,
      "dur": 32.75,
      "speech_start": 0.0,
      "speech_end": 31.85,
      "sentences": [
        {
          "i": 0,
          "text": "If this gave you something to sit with tonight, then stay with us.",
          "start": 0.0,
          "dur": 4.53,
          "abs_start": 632.2
        },
        {
          "i": 1,
          "text": "One honest question at a time, followed as far as it actually goes.",
          "start": 4.53,
          "dur": 5.306,
          "abs_start": 636.73
        },
        {
          "i": 2,
          "text": "The next one is the question hiding underneath this whole video.",
          "start": 9.836,
          "dur": 4.374,
          "abs_start": 642.036
        },
        {
          "i": 3,
          "text": "Whether any truth can hold at all, no matter who believes it.",
          "start": 14.71,
          "dur": 4.636,
          "abs_start": 646.91
        },
        {
          "i": 4,
          "text": "Subscribe so you are here when we look at it.",
          "start": 19.346,
          "dur": 2.982,
          "abs_start": 651.546
        },
        {
          "i": 5,
          "text": "And if you think I got something wrong somewhere, say so, because that is exactly how this gets sharper.",
          "start": 22.328,
          "dur": 7.292,
          "abs_start": 654.528
        },
        {
          "i": 6,
          "text": "I will see you in the next one.",
          "start": 29.62,
          "dur": 2.23,
          "abs_start": 661.82
        }
      ],
