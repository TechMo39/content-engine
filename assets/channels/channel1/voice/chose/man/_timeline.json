          "file": "assets/channels/channel1/sfx/s04_end.mp3"
        }
      ]
    },
    {
      "scene": 5,
      "tone": "rustig",
      "wav": "assets/channels/channel1/voice/chose/man/05.wav",
      "start": 194.15,
      "dur": 35.125,
      "speech_start": 0.34,
      "speech_end": 34.06,
      "sentences": [
        {
          "i": 0,
          "text": "And it is everywhere.",
          "start": 0.34,
          "dur": 2.09,
          "abs_start": 194.49
        },
        {
          "i": 1,
          "text": "You do not argue your own court case on a feeling, you find someone who knows the law.",
          "start": 2.43,
          "dur": 5.7,
          "abs_start": 196.58
        },
        {
          "i": 2,
          "text": "You do not walk onto a bridge because it looks solid, someone spent years proving it holds your weight.",
          "start": 8.13,
          "dur": 6.192,
          "abs_start": 202.28
        },
        {
          "i": 3,
          "text": "You do not take a medicine because the box looks nice, you want to know what it does.",
          "start": 14.322,
          "dur": 5.73,
          "abs_start": 208.472
        },
        {
          "i": 4,
          "text": "Anywhere the stakes are real, you do the same thing.",
          "start": 20.052,
          "dur": 3.388,
          "abs_start": 214.202
        },
        {
          "i": 5,
          "text": "You find out first, and you decide second.",
          "start": 23.44,
          "dur": 3.234,
          "abs_start": 217.59
        },
        {
          "i": 6,
          "text": "Taking something on blind, just because it was put in front of you, that would be reckless.",
          "start": 26.674,
          "dur": 6.138,
          "abs_start": 220.824
        },
        {
          "i": 7,
          "text": "And you know it.",
          "start": 32.812,
          "dur": 1.248,
          "abs_start": 226.962
        }
      ],
      "beats": [
        {
          "start": 0.34,
          "dur": 7.79,
          "label": "de rechtszaak: de wet",
          "img": "",
          "vid": "assets/channels/channel1/video/chose/s05b1.mp4"
        },
        {
