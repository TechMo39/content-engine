    {
      "scene": 13,
      "tone": "outro",
      "wav": "assets/channels/channel1/voice/chose/man/13.wav",
      "start": 589.35,
      "dur": 49.975,
      "speech_start": 0.36,
      "speech_end": 48.5,
      "sentences": [
        {
          "i": 0,
          "text": "And that question is where we go next.",
          "start": 0.36,
          "dur": 2.67,
          "abs_start": 589.71
        },
        {
          "i": 1,
          "text": "But before you wander off, let me say the quiet part out loud.",
          "start": 3.03,
          "dur": 5.136,
          "abs_start": 592.38
        },
        {
          "i": 2,
          "text": "This channel has one job.",
          "start": 8.166,
          "dur": 2.024,
          "abs_start": 597.516
        },
        {
          "i": 3,
          "text": "To take the big questions, the ones most people flinch away from at the dinner table, and look at them honestly, one at a time.",
          "start": 10.19,
          "dur": 9.982,
          "abs_start": 599.54
        },
        {
          "i": 4,
          "text": "No preaching.",
          "start": 20.172,
          "dur": 1.153,
          "abs_start": 609.522
        },
        {
          "i": 5,
          "text": "No being talked down to.",
          "start": 21.325,
          "dur": 2.305,
          "abs_start": 610.675
        },
        {
          "i": 6,
          "text": "Just an honest look, and the occasional bad joke.",
          "start": 23.63,
          "dur": 3.96,
          "abs_start": 612.98
        },
        {
          "i": 7,
          "text": "If that is something you have been missing, then come with us.",
          "start": 27.59,
          "dur": 4.942,
          "abs_start": 616.94
        },
        {
          "i": 8,
          "text": "Subscribe, so the next one actually finds you instead of getting buried under cat videos.",
          "start": 32.532,
          "dur": 7.245,
          "abs_start": 621.882
        },
        {
          "i": 9,
          "text": "Because the next one asks whether any truth holds at all, and I would genuinely like you there when we find out.",
          "start": 39.777,
          "dur": 8.723,
          "abs_start": 629.127
        }
      ],
