      "sentences": [
        {
          "i": 0,
          "text": "Welcome to Umma United.",
          "start": 0.3,
          "dur": 1.9,
          "abs_start": 11.125
        },
        {
          "i": 1,
          "text": "This is where we hand you back the side of the story you were never told.",
          "start": 2.2,
          "dur": 4.4,
          "abs_start": 13.025
        },
        {
          "i": 2,
          "text": "Our history.",
          "start": 6.6,
          "dur": 1.13,
          "abs_start": 17.425
        },
        {
          "i": 3,
          "text": "Our pride.",
          "start": 7.73,
          "dur": 1.05,
          "abs_start": 18.555
        },
        {
          "i": 4,
          "text": "Our present.",
          "start": 8.78,
